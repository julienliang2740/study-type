{
  "name": "@type-study/process-input",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:worker": "wrangler dev --port 8788 --persist-to ../../.wrangler/state",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^22.15.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "^4.24.0"
  },
  "dependencies": {
    "pdfjs-dist": "^6.1.200"
  }
}
